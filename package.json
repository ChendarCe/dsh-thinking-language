{
  "name": "dsh-thinking-language",
  "version": "1.0.0",
  "type": "module",
  "description": "Make the agent think in Chinese, with a settings switch and a fully overriding custom prompt.",
  "license": "MIT",
  "author": "ChendarCe",
  "homepage": "https://github.com/ChendarCe/dsh-thinking-language#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChendarCe/dsh-thinking-language.git"
  },
  "bugs": {
    "url": "https://github.com/ChendarCe/dsh-thinking-language/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "reasoning-language",
    "chinese",
    "thinking"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
